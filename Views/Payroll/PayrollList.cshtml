             document.getElementById("exportExcelBtn").onclick = function () {

        const wb = XLSX.utils.book_new();
        const wsData = [];

        let totalEmployees = 0;
        let totalGrossSalary = 0;
        let totalDeduction = 0;
        let totalNetSalary = 0;

        // HEADER
        wsData.push([
            "Emp Code",
            "Name",
            "Working Days",
            "Half Days",
            "Absent Days",
            "Paid Days",
            "Basic Salary",
            "Gross Salary",
            "Deduction",
            "Net Salary",
            "Bank Name",
            "Account No",
            "IFSC Code"
        ]);

        // DATA
        allRows.forEach(r => {

            const c = r.cells;

            let workingDays = parseFloat(c[2].innerText) || 0;
            let halfDays = parseFloat(c[3].innerText) || 0;
            let absentDays = parseFloat(c[4].innerText) || 0;
            let paidDays = parseFloat(c[5].innerText) || 0;

            let basicSalary = parseFloat(c[6].innerText.replace(/[^0-9.-]+/g,"")) || 0;
            let grossSalary = parseFloat(c[7].innerText.replace(/[^0-9.-]+/g,"")) || 0;
            let deduction = parseFloat(c[8].innerText.replace(/[^0-9.-]+/g,"")) || 0;
            let netSalary = parseFloat(c[9].innerText.replace(/[^0-9.-]+/g,"")) || 0;

            // Bank details (stored as data attributes)
            let bankName = r.dataset.bank || "";
            let accountNo = r.dataset.account || "";
            let ifsc = r.dataset.ifsc || "";

            totalEmployees++;
            totalGrossSalary += grossSalary;
            totalDeduction += deduction;
            totalNetSalary += netSalary;

            wsData.push([
                c[0].innerText,
                c[1].innerText,
                workingDays,
                halfDays,
                absentDays,
                paidDays,
                basicSalary,
                grossSalary,
                deduction,
                netSalary,
                bankName,
                accountNo,
                ifsc
            ]);
        });

        wsData.push([]);

        wsData.push([
            "", "", "", "", "", "", "", "", "Total Net Salary", totalNetSalary, "", "", ""
        ]);

        const ws = XLSX.utils.aoa_to_sheet(wsData);

        ws['!cols'] = [
            { wch: 12 },
            { wch: 28 },
            { wch: 12 },
            { wch: 10 },
            { wch: 12 },
            { wch: 10 },
            { wch: 15 },
            { wch: 15 },
            { wch: 12 },
            { wch: 15 },
            { wch: 20 },
            { wch: 20 },
            { wch: 18 }
        ];

        XLSX.utils.book_append_sheet(wb, ws, "Payroll");

        XLSX.writeFile(wb, "Payroll_Report.xlsx");
    };
   

</script>
